# --- LLM provider (required) ---
OPENAI_API_KEY=sk-...
# Models per agent -- override individually if you want to trade cost vs. quality.
OPENAI_MODEL_DISCOVERY=gpt-4o
OPENAI_MODEL_SCORING=gpt-4o-mini
OPENAI_MODEL_RECOMMENDATION=gpt-4o

# --- Real search-data provider (optional) ---
# If both are set, VisibilityScoringAgent pulls real search volume / keyword
# difficulty from DataForSEO. If either is missing, the app automatically
# falls back to a deterministic heuristic estimator (see README "Tradeoffs").
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Database ---
DATABASE_URL=sqlite:///dev.db

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-me
PORT=5000

# --- Rate limiting (bonus) ---
RATELIMIT_STORAGE_URI=memory://
PIPELINE_RUN_RATE_LIMIT=10 per hour
